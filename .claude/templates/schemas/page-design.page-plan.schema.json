{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aura Engine: page/page-plan.json (página v2)",
  "description": "Plano da página escrito pela skill `page-design`. Campos `required` são só os que outra skill lê; qualquer campo extra é aceito. Validado só em página v2 (`schema_version: 2`) por `tools/page-qa/qa_gate.py`, no pré-flight da `page-build`. Página antiga não é validada.",
  "type": "object",
  "required": ["schema_version", "page_type", "strategy", "sections_plan", "section_order", "commerce"],
  "properties": {
    "schema_version": {"const": 2},
    "page_type": {"type": "string"},
    "strategy": {
      "type": "object",
      "required": ["page_type", "mechanism_name"],
      "properties": {"page_type": {"type": "string"}, "mechanism_name": {"type": "string", "minLength": 1}}
    },
    "sections_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["id", "media"], "properties": {"id": {"type": "string"}, "media": {"type": "object"}}}
    },
    "section_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "commerce": {"type": "object"},
    "build_mode": {"enum": ["direction", "reference"]},
    "design_route": {"enum": ["direction", "reference", "claude-design", "singlefile-clone", "section-puzzle"]},
    "direction_ref": {"type": ["string", "null"]},
    "reference_capture_ref": {"type": ["string", "null"]},
    "qa_metrics_ref": {"type": ["string", "null"]},
    "review_ref": {"type": ["string", "null"]},
    "preview_url": {"type": ["string", "null"]},
    "qa_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "motivo", "data"],
        "properties": {
          "item": {"enum": ["horizontal_overflow", "broken_images", "html_css_kb"]},
          "motivo": {"type": "string", "minLength": 3},
          "data": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"}
        }
      }
    }
  }
}
