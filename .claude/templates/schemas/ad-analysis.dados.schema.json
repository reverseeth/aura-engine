{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aura Engine: ad-analysis/dados.json",
  "description": "Última análise de performance: KPI da campanha, classificação nas 4 classes do cânone, sinais de saúde, diagnóstico de página, espiral do ROAS, PSM real e ação recomendada. Escrito pela skill `ad-analysis`. Lido por: finance-engine, creative-engine, creator-engine, scale-engine, promo-engine, team-engine, content-recycler, marketplace-engine. Campos `required` são só os que outra skill lê; qualquer campo extra é aceito (`additionalProperties: true`). Validado por `python3 tools/manifest.py <slug> complete ad-analysis` e por `python3 tools/aura-status.py <slug>`.",
  "type": "object",
  "required": [
    "analysis_id",
    "test_capacity_check",
    "breakthroughs",
    "spend_winners",
    "kpi_winners",
    "losers",
    "winners",
    "health_signals",
    "iteration_zone_check",
    "click_based_purchase_share",
    "psm_real",
    "psm_real_basis",
    "recommended_action"
  ],
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "analyzed_at": {
      "type": "string",
      "description": "ISO-8601"
    },
    "current_daily_spend": {
      "type": "number"
    },
    "current_cpa_avg": {
      "type": "number"
    },
    "current_roas_avg": {
      "type": "number"
    },
    "campaign_kpi": {
      "type": "object",
      "properties": {
        "campaign_cpa": {
          "type": "number"
        },
        "campaign_roas": {
          "type": "number"
        },
        "account_spend_7d": {
          "type": "number"
        },
        "window_days": {
          "type": "integer"
        },
        "stable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "batch_rates": {
      "type": "object",
      "properties": {
        "concepts_tested": {
          "type": "integer"
        },
        "hit_rate": {
          "type": "number"
        },
        "breakthrough_rate": {
          "type": "number"
        },
        "volume_up_rate_down": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "test_capacity_check": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "ad-strategy",
            "none"
          ]
        },
        "binding_constraint": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "max_adsets",
            "floor",
            "adset_cap_5",
            "batch_size",
            "margin_warning",
            "none",
            null
          ]
        },
        "below_floor_directional_only": {
          "type": "boolean"
        },
        "directional_only_analysis": {
          "type": "boolean"
        }
      },
      "required": [
        "directional_only_analysis"
      ],
      "additionalProperties": true
    },
    "active_breakthroughs_count": {
      "type": "integer"
    },
    "active_losers_count": {
      "type": "integer"
    },
    "breakthroughs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "creative_id": {
            "type": "string"
          },
          "ad_class": {
            "type": "string",
            "enum": [
              "breakthrough"
            ]
          },
          "cpa": {
            "type": "number"
          },
          "roas": {
            "type": "number"
          },
          "spend_total": {
            "type": "number"
          },
          "spend_share_7d": {
            "type": "number"
          },
          "ad_kpi_vs_campaign": {
            "type": "boolean"
          },
          "hook_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "hold_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "days_active": {
            "type": "integer"
          },
          "ad_set_id": {
            "type": "string"
          },
          "winning_sub_avatar_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "creative_id",
          "ad_class"
        ],
        "additionalProperties": true
      }
    },
    "spend_winners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "creative_id": {
            "type": "string"
          },
          "ad_class": {
            "type": "string",
            "enum": [
              "spend_winner"
            ]
          },
          "cpa": {
            "type": "number"
          },
          "roas": {
            "type": "number"
          },
          "spend_total": {
            "type": "number"
          },
          "spend_share_7d": {
            "type": "number"
          },
          "ad_kpi_vs_campaign": {
            "type": "boolean"
          },
          "hook_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "hold_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "days_active": {
            "type": "integer"
          },
          "next_action": {
            "type": "string"
          }
        },
        "required": [
          "creative_id",
          "ad_class"
        ],
        "additionalProperties": true
      }
    },
    "kpi_winners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "creative_id": {
            "type": "string"
          },
          "ad_class": {
            "type": "string",
            "enum": [
              "kpi_winner"
            ]
          },
          "cpa": {
            "type": "number"
          },
          "roas": {
            "type": "number"
          },
          "spend_total": {
            "type": "number"
          },
          "spend_share_7d": {
            "type": "number"
          },
          "ad_kpi_vs_campaign": {
            "type": "boolean"
          },
          "hook_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "hold_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "days_active": {
            "type": "integer"
          },
          "treated_as": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          }
        },
        "required": [
          "creative_id",
          "ad_class"
        ],
        "additionalProperties": true
      }
    },
    "losers": {
      "type": "array",
      "items": {
        "type": "object",
