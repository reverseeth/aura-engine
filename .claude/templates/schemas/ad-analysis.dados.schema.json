          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "iteration_zone_check": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "iteration_creative_id": {
            "type": "string"
          },
          "original_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "zone_original": {
            "type": "string"
          },
          "zone_iteration": {
            "type": "string"
          },
          "zone_changed": {
            "type": "boolean"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "zone_shift_suspected",
              "variable_isolated",
              "no_data"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "roas_spiral_check": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "finance-engine",
            "offer-builder",
            "none"
          ]
        },
        "fixed_costs_monthly": {
          "type": [
            "number",
            "null"
          ]
        },
        "breakeven_roas_with_fixed": {
          "type": [
            "number",
            "null"
          ]
        },
        "spend_to_breakeven_with_fixed": {
          "type": [
            "number",
            "null"
          ]
        },
        "finance_verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "covers_fixed_costs",
            "scale_up_accept_lower_roas",
            "cut_spend_below_variable_breakeven",
            "blocked_pending_fixed_costs",
            null
          ]
        },
        "spend_cut_considered": {
          "type": "boolean"
        },
        "spend_cut_recommended": {
          "type": "boolean"
        },
        "blocked_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "click_based_purchase_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "nunca estimado; null = sem breakdown"
    },
    "psm_real": {
      "type": "number"
    },
    "psm_real_basis": {
      "type": "string",
      "enum": [
        "shopify_new_customer",
        "platform_cpa_proxy"
      ]
    },
    "cac_real": {
      "type": [
        "number",
        "null"
      ]
    },
    "new_customers_period": {
      "type": [
        "integer",
        "null"
      ]
    },
    "margin_per_order_weighted": {
      "type": "number"
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "continue",
        "scale",
        "iterate_creatives",
        "refresh_creatives",
        "kill",
        "fix_funnel",
        "fix_copy_specimen",
        "test_other_account",
        "ask_fixed_costs",
        "raise_spend_accept_lower_roas",
        "raise_budget_or_reduce_concepts"
      ]
    }
  },
  "additionalProperties": true
}
