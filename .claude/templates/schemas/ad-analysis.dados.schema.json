    "health_signals": {
      "type": "object",
      "properties": {
        "frequency_max": {
          "type": "number"
        },
        "cpm_trend": {
          "type": "string",
          "enum": [
            "up",
            "flat",
            "down"
          ]
        },
        "creative_age_days_oldest": {
          "type": "integer"
