      "required": [
        "account_cpm_suspect",
        "funnel_broken"
      ],
      "additionalProperties": true
    },
    "page_diagnosis": {
      "type": "object",
      "properties": {
        "specimen_primary": {
          "type": [
            "string",
            "null"
          ]
        },
        "specimen_fit": {
