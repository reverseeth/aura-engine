              "problem",
              "desire",
              "frustration"
            ]
          }
        },
        "required": [
          "id",
          "phrase"
        ],
        "additionalProperties": true
      }
    },
    "voc_count": {
      "type": "integer",
      "minimum": 0
    },
    "voc_adequacy": {
