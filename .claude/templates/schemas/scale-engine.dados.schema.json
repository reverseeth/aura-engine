    "plan_id": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "starter",
        "validating",
        "scaling"
      ]
    },
    "scale_phase": {
      "type": "string",
      "enum": [
        "testing",
        "traction",
        "initial_scale",
        "aggressive",
        "optimization"
      ]
    },
    "scaling_school": {
      "type": "string",
      "enum": [
        "A_cost_cap_surf",
        "B_bid_cap",
        "C_budget_doubling"
      ]
    },
    "current_daily_spend": {
      "type": "number"
    },
    "target_daily_spend_30d": {
