{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aura Engine: scale-engine/dados.json",
  "description": "Plano de escala: estágio, escola, gatilho de escala (só breakthrough), Scaling Protocol, reset da meia-noite, gate de custo fixo, caixa e suprimento. Escrito pela skill `scale-engine`. Lido por: ad-analysis (via scale-directives.md e manifest), creative-engine (scale-directives.md), member-stage-awareness (scale_phase). Campos `required` são só os que outra skill lê; qualquer campo extra é aceito (`additionalProperties: true`). Validado por `python3 tools/manifest.py <slug> complete scale-engine` e por `python3 tools/aura-status.py <slug>`.",
  "type": "object",
  "required": [
    "stage",
    "scale_phase",
    "scaling_school",
    "breakeven_cpa",
    "psm_real",
    "psm_real_basis",
    "readiness_blockers",
    "scale_trigger",
    "scaling_protocol"
  ],
